{
  "name": "research-garden",
  "description": "Engineering and research notes published with Astro and Starlight",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Senthilnathan",
  "license": "MIT",
  "homepage": "https://senthilnathan01.github.io/research-garden/",
  "repository": {
    "type": "git",
    "url": "https://github.com/senthilnathan01/research-garden.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate:content": "node ./scripts/validate-content.mjs",
    "audit:build": "node ./scripts/audit-build.mjs",
    "check": "npm run validate:content && astro check && prettier . --check",
    "format": "prettier . --write",
    "test": "tsx --test",
    "verify": "npm run check && npm test && npm run build && npm run audit:build"
  },
  "engines": {
    "npm": ">=9.6.5",
    "node": ">=22.12.0"
  },
  "keywords": [
    "documentation",
    "research",
    "engineering",
    "astro",
    "starlight"
  ],
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "astro": "^7.1.3",
    "js-yaml": "^4.1.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.10",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
