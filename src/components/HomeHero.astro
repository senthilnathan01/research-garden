---
import ProjectDirectory from "./ProjectDirectory.astro"

const base = import.meta.env.BASE_URL
---

<div class="home-intro" data-pagefind-ignore>
  <section class="home-hero">
    <div class="home-hero-copy">
      <p class="home-eyebrow">Research Garden</p>
      <h1 id="_top">Research projects</h1>
      <p>Experiments, results, and the notes needed to understand how each project developed.</p>
      <div class="home-hero-actions">
        <button class="home-search-action" type="button">
          Search projects and notes <kbd>⌘ K</kbd>
        </button>
      </div>
    </div>
  </section>

  <ProjectDirectory />

  <nav class="home-utility-links" aria-label="More ways to explore">
    <a href={`${base}graph/`}>
      <strong>Graph</strong>
      <span>Follow links between projects and notes.</span>
    </a>
  </nav>
</div>

<script>
  const setUpSearchProxy = () => {
    const proxy = document.querySelector<HTMLButtonElement>(".home-search-action")
    if (!proxy || proxy.dataset.ready) return
    proxy.dataset.ready = "true"
    proxy.addEventListener("click", () => {
      requestAnimationFrame(() => {
        document.querySelector<HTMLButtonElement>("site-search button[data-open-modal]")?.click()
      })
    })
  }

  setUpSearchProxy()
  document.addEventListener("astro:page-load", setUpSearchProxy)
</script>
