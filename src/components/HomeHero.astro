---
const base = import.meta.env.BASE_URL
---

<div class="home-intro" data-pagefind-ignore>
  <section class="home-hero">
    <div class="home-hero-copy">
      <p class="home-eyebrow">Engineering notes, kept in context</p>
      <h1 id="_top">The messy work stays.</h1>
      <p>Projects, experiments, and references, kept beside the decisions that shaped them.</p>
      <div class="home-hero-actions">
        <a class="home-primary-action" href={`${base}projects/`}>Browse projects</a>
        <button class="home-search-action" type="button">
          Search the garden <kbd>⌘ K</kbd>
        </button>
      </div>
    </div>
    <picture class="home-hero-visual">
      <source media="(max-width: 800px)" srcset={`${base}research-workbench-900.webp`} />
      <img
        src={`${base}research-workbench.webp`}
        alt="An open research notebook, experiment plots, and a laptop on a working desk"
        width="1440"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </section>

  <nav class="home-entry-points" aria-label="Research garden highlights">
    <a class="home-current-project" href={`${base}projects/open-ai-challenge-parameter-golf/`}>
      <span>
        <small>Current project</small>
        <strong>OpenAI Challenge: Parameter Golf</strong>
      </span>
      <p>Track bets, experiments, references, and submissions for the parameter golf challenge.</p>
      <b>View project</b>
    </a>
    <div class="home-reference-links">
      <a href={`${base}templates/`}>
        <strong>Templates</strong>
        <p>Start with a useful structure, then change it to fit the work.</p>
        <span>Browse templates</span>
      </a>
      <a href={`${base}graph/`}>
        <strong>Graph</strong>
        <p>See which notes connect and where an idea shows up again.</p>
        <span>Open graph</span>
      </a>
    </div>
  </nav>
</div>

<script>
  const setUpSearchProxy = () => {
    const proxy = document.querySelector<HTMLButtonElement>(".home-search-action")
    if (!proxy || proxy.dataset.ready) return
    proxy.dataset.ready = "true"
    proxy.addEventListener("click", () => {
      const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent)
      document.dispatchEvent(
        new KeyboardEvent("keydown", {
          key: "k",
          code: "KeyK",
          metaKey: isMac,
          ctrlKey: !isMac,
          bubbles: true,
        }),
      )
    })
  }

  setUpSearchProxy()
  document.addEventListener("astro:page-load", setUpSearchProxy)
</script>
