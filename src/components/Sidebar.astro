---
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro"
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro"

const { id, sidebar } = Astro.locals.starlightRoute
const base = import.meta.env.BASE_URL
type SidebarEntry = (typeof sidebar)[number]

function findGroup(label: string): SidebarEntry | undefined {
  return sidebar.find((entry) => entry.type === "group" && entry.label === label)
}

function findLink(entries: SidebarEntry[], href: string): SidebarEntry | undefined {
  for (const entry of entries) {
    if (entry.type === "link" && entry.href === href) return entry
    if (entry.type === "group") {
      const nested = findLink(entry.entries, href)
      if (nested) return nested
    }
  }
}

function keepPrefix(entry: SidebarEntry, prefix: string): SidebarEntry | undefined {
  if (entry.type === "link") return entry.href.startsWith(prefix) ? entry : undefined

  const entries = entry.entries
    .map((child) => keepPrefix(child, prefix))
    .filter((child): child is SidebarEntry => child !== undefined)

  return entries.length > 0 ? { ...entry, entries } : undefined
}

const gardenGroup = findGroup("Garden")
const projectsGroup = findGroup("Projects")
const templatesGroup = findGroup("Template library")
const projectsLink = findLink(sidebar, `${base}projects/`)
const graphLink = findLink(sidebar, `${base}graph/`)
const projectId = id.match(/^projects\/[^/]+/)?.[0]

let scopedSidebar: SidebarEntry[]

if (projectId) {
  const prefix = `${base}${projectId}/`
  const projectEntries =
    projectsGroup?.type === "group"
      ? projectsGroup.entries
          .map((entry) => keepPrefix(entry, prefix))
          .filter((entry): entry is SidebarEntry => entry !== undefined)
      : []

  scopedSidebar = [...(projectsLink ? [projectsLink] : []), ...projectEntries]
} else if (id === "projects") {
  scopedSidebar = [gardenGroup, projectsGroup].filter(
    (entry): entry is SidebarEntry => entry !== undefined,
  )
} else if (id === "templates" || id.startsWith("templates/")) {
  scopedSidebar = [projectsLink, graphLink, templatesGroup].filter(
    (entry): entry is SidebarEntry => entry !== undefined,
  )
} else {
  scopedSidebar = [gardenGroup, projectsGroup].filter(
    (entry): entry is SidebarEntry => entry !== undefined,
  )
}
---

<SidebarSublist sublist={scopedSidebar} />

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
