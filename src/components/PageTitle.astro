---
import Default from "@astrojs/starlight/components/PageTitle.astro"
import GraphExplorer from "./GraphExplorer.astro"
import HomeHero from "./HomeHero.astro"
import ProjectDirectory from "./ProjectDirectory.astro"

const { id } = Astro.locals.starlightRoute
---

{
  id === "" ? (
    <HomeHero />
  ) : (
    <>
      <Default>
        <slot />
      </Default>
      {id === "projects" && <ProjectDirectory heading="Public projects" />}
      {id === "graph" && <GraphExplorer />}
    </>
  )
}
