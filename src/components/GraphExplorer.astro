---
import { buildGardenGraph } from "../lib/content-graph"

const graph = buildGardenGraph()
const base = import.meta.env.BASE_URL
const width = 820
const height = 500
const centerX = width / 2
const centerY = height / 2
const radius = 205
const positions = new Map(
  graph.pages.map((page, index) => {
    const angle = -Math.PI / 2 + (index / graph.pages.length) * Math.PI * 2
    const depth = page.id.split("/").filter(Boolean).length
    const depthOffset = Math.min(depth, 4) * 18
    return [
      page.id,
      {
        x: centerX + Math.cos(angle) * (radius + depthOffset),
        y: centerY + Math.sin(angle) * (radius + depthOffset),
      },
    ]
  }),
)
---

<section class="graph-explorer" aria-labelledby="graph-title" data-pagefind-ignore>
  <div class="graph-heading">
    <div>
      <p class="graph-kicker">Content map</p>
      <h2 id="graph-title">{graph.pages.length} notes, {graph.edges.length} links</h2>
    </div>
    <p>Every node is a page. Every line is a link written in the notes.</p>
  </div>
  <div class="graph-canvas">
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="graph-svg-title">
      <title id="graph-svg-title">Research Garden content graph</title>
      <g class="graph-edges" aria-hidden="true">
        {
          graph.edges.map((edge) => {
            const source = positions.get(edge.source)
            const target = positions.get(edge.target)
            return source && target ? (
              <line x1={source.x} y1={source.y} x2={target.x} y2={target.y} />
            ) : null
          })
        }
      </g>
      <g class="graph-nodes">
        {
          graph.pages.map((page) => {
            const position = positions.get(page.id)
            if (!position) return null
            const isRoot = page.id === ""
            return (
              <a href={`${base}${page.id ? `${page.id}/` : ""}`} aria-label={page.title}>
                <circle
                  cx={position.x}
                  cy={position.y}
                  r={isRoot ? 10 : 6}
                  class:list={{ root: isRoot }}
                />
                <title>{page.title}</title>
              </a>
            )
          })
        }
      </g>
      <text x={centerX} y={centerY - 7} text-anchor="middle">Research</text>
      <text x={centerX} y={centerY + 15} text-anchor="middle">Garden</text>
    </svg>
  </div>
  <details class="graph-index">
    <summary>Browse all nodes</summary>
    <ul>
      {
        graph.pages.map((page) => (
          <li>
            <a href={`${base}${page.id ? `${page.id}/` : ""}`}>
              <strong>{page.title}</strong>
              <span>{page.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</section>
